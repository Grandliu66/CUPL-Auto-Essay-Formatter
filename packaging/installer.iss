; Inno Setup 6 script. Build via packaging\build.ps1 (it passes /DAppVersion=...).
; Per-user install by default (no admin rights needed): {autopf} -> %LOCALAPPDATA%\Programs.

#ifndef AppVersion
  #define AppVersion "1.0.0"
#endif
; Display name shown in the wizard / Start menu / Add-Remove Programs (English name: CUPL Undergraduate Thesis Auto-Formatter).
; (Install folder, exe name, AppId and the %APPDATA% folder stay ASCII on purpose.)
#define AppName "CUPL本科论文自动排版工具"
#define AppExe  "CUPL-Undergraduate-Thesis-Auto-Formatter.exe"

[Setup]
AppId={{D8D0179A-F5EE-4A67-BC23-A07D3925F72E}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisherURL=https://github.com/Grandliu66
DefaultDirName={autopf}\CUPL Undergraduate Thesis Auto-Formatter
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
OutputDir=..\dist\installer
OutputBaseFilename=CUPL-UTAF V{#AppVersion}
SetupIconFile=..\essay_tool\gui\assets\app.ico
UninstallDisplayIcon={app}\{#AppExe}
Compression=lzma2/max
SolidCompression=yes
LicenseFile=..\build\license_zh.rtf
WizardStyle=modern
ShowLanguageDialog=no
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

[Languages]
Name: "chinesesimplified"; MessagesFile: "languages\ChineseSimplified.isl"

[Messages]
WelcomeLabel1=欢迎使用[name]！
WelcomeLabel2=本产品系学生公益开发，同中国政法大学官方无关，不代表官方。
; 许可协议页的提示语：去掉 Inno 自带的后半句"在继续安装前您必须同意这些协议条款。"（用户 2026-09-20）
LicenseLabel3=请阅读下列许可协议。

[Tasks]
Name: "desktopicon"; Description: "创建桌面快捷方式"

[Files]
Source: "..\dist\CUPL-Undergraduate-Thesis-Auto-Formatter\*"; DestDir: "{app}"; Flags: recursesubdirs ignoreversion createallsubdirs
; License notices (own MIT license, third-party notices, Python/OpenSSL terms) - generated by make_notices.py
Source: "..\build\licenses\*"; DestDir: "{app}\licenses"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExe}"; Description: "立即运行 {#AppName}"; Flags: nowait postinstall skipifsilent

[Code]
// On uninstall, ask whether to also delete the user's data (saved presets, import backups, settings).
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataDir: String;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    if UninstallSilent then Exit;   // silent uninstall never asks and always keeps the user data
    DataDir := ExpandConstant('{userappdata}\AutoEssayTypesettingTool');
    if DirExists(DataDir) then
      if MsgBox('是否同时删除你的个人数据（保存的配置、导入备份、设置）？' + #13#10 + #13#10 +
                '选“否”可保留，以后重新安装仍能继续使用。' + #13#10 + DataDir,
                mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
        DelTree(DataDir, True, True, True);
  end;
end;
