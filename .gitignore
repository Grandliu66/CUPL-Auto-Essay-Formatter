# ---- 虚拟环境与缓存（可重建）
.venv/
packaging/.venv/
__pycache__/
*.pyc

# ---- 构建产物（packaging\build.ps1 随时可以重出）
build/
dist/

# ---- 临时/中间产物与自动备份（不进版本库；留在磁盘上不动）
work/
backup/
Adversarial Automatic Test/_out/

# ---- Office 打开文档时留下的锁文件/临时文件
~$*
*.tmp

# ---- 开发过程中的一次性调试/探测脚本（留在本地即可，不进版本库）
tools/_*.py
Adversarial Automatic Test/_*.py
# run_aat.py 官方十层跑批实际会调用这两个（不是一次性脚本，得留着）
!Adversarial Automatic Test/_rerun_all.py
!Adversarial Automatic Test/_check_alerts_edge.py

# ---- 一次性/按日期的开发脚本与本机备份工具（本地留存，不进公开仓库）
tools/check_*_2026*.py
tools/audit_readonly*.py
tools/backup_snapshot.py
tools/check_revert_risk.py
tools/crash_demo.py
tools/edit_logic_sheet.py
tools/edit_outline_round5.py
tools/fill_outline_sheet2.py
tools/fix_number_spacing.py
tools/make_outline_xlsx.py
tools/rebuild_outline_sheet2.py
tools/renumber_outline.py
tools/repair_main_window.py
tools/restore_from_local_history.py
tools/purge_orphan_editing_sessions.py
tools/strip_bom.py
备份.cmd

# ---- 根目录下随手放的压缩包/PDF（与源码无关）
/*.zip
/*.pdf

# ---- 编辑器/AI 工具本地状态，与项目无关
.vscode/tasks.json
.continue/

# ---- 开发参考资料：含用户本人真实稿件、内部设计草稿；本地留着给 AAT/开发用，不进公开仓库
# （例外：下面 5 份学校官网公开的官方文件是程序运行必需的——封面生成、《规范》查看都要读——
#  必须随源码一起提供，哈希见 essay_tool/config/integrity_hashes.py）
reference/*
!reference/中国政法大学本科生毕业论文写作模板.docx
!reference/中国政法大学本科生课程考核封面.docx
!reference/附件七：第二十四届“学术十星”论文大赛论文封面范例.docx
!reference/中国政法大学本科毕业论文撰写格式规范.docx
!reference/附件二 ：第二十四届“学术十星”论文大赛参赛作品撰写格式.pdf
docs/
